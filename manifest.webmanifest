{"name":"Chip Chop Pet Shop","short_name":"Chip Chop","description":"Pet shop en Quito con alimento y accesorios para perros, gatos, conejos y peces. Compra en línea, paga con Deuna y retira en tienda o recibe en tu casa.","start_url":"/","display":"standalone","background_color":"#FFFFFF","theme_color":"#3B688A","lang":"es-EC","icons":[{"src":"/img/icon-192.png","sizes":"192x192","type":"image/png"},{"src":"/img/icon-512.png","sizes":"512x512","type":"image/png"}]}