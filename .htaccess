# Chip Chop Pet Shop: sitio estático (Next.js export) en hosting web de Hostinger
Options -Indexes
DirectoryIndex index.html
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On
  # Forzar HTTPS
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^ https://chipchoppetshop.com%{REQUEST_URI} [L,R=301]
  # Quitar www (una sola URL canónica)
  RewriteCond %{HTTP_HOST} ^www\.chipchoppetshop\.com$ [NC]
  RewriteRule ^ https://chipchoppetshop.com%{REQUEST_URI} [L,R=301]
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  <FilesMatch "\.(woff2|webp|png|jpg|ico|svg)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>

# Los archivos de _next/static llevan hash en el nombre: se pueden cachear un año
<IfModule mod_headers.c>
  <If "%{REQUEST_URI} =~ m#^/_next/static/#">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>
</IfModule>

AddType text/plain .txt
AddCharset utf-8 .txt .html .xml .webmanifest
